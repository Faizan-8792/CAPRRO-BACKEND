# Runtime
NODE_ENV=development
PORT=4001

# Required secrets: set locally or in hosting environment. Never commit values.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# MongoDB pool tuning
MONGO_POOL_MIN=5
MONGO_POOL_MAX=50

# Google OAuth public client identifiers
# Existing Chrome extension/web audience
GOOGLE_CLIENT_ID=872672491022-nbla94i0c3lo1d7gcbhvfs88mrlp15fj.apps.googleusercontent.com
# Native WinUI desktop audience
GOOGLE_DESKTOP_CLIENT_ID=978304461373-1ombfrb0ergt0nq942cjbg7jnq9qqb0u.apps.googleusercontent.com
# Optional comma-separated additional trusted audiences
GOOGLE_CLIENT_IDS=
# Google issues installed-app ("Desktop app") clients a secret and requires it
# at the token endpoint. Set the value only in the hosting environment so it is
# never shipped inside the desktop build. Leave blank here.
GOOGLE_DESKTOP_CLIENT_SECRET=

# Email and optional AI provider secrets
RESEND_API_KEY=
DEEPSEEK_API_KEY=

# OCR provider for notice intake (POST /api/cases/ocr).
#
# Set this in the hosting environment only. Without it the route answers 503
# with OCR_PROVIDER_UNAVAILABLE and no file is read; nothing is ever stored
# either way, because the route is zero-write by design.
#
# Get a key from https://ocr.space/ocrapi. The free tier is rate limited, so a
# firm reading many notices needs a paid key. Note the route is billed per call
# and is reachable by any firm member, so treat the key as a spend control.
OCR_SPACE_API_KEY=

# Optional signing-secret overrides for the two TDS token flows.
#
# Both fall back to JWT_SECRET when unset, which is the normal configuration.
# Set them only to rotate TDS token signing independently of session signing.
# If neither they nor JWT_SECRET are set, both flows fail closed with 503
# rather than signing with a default.
TDS_ACTION_PLAN_SECRET=
TDS_IMPORT_PREVIEW_SECRET=
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_FALLBACK=deepseek-v4-pro
DEEPSEEK_CLASSIFIER_MODEL=deepseek-v4-pro
DEEPSEEK_INSIGHTS_MODEL=deepseek-v4-flash

# Google desktop PKCE does not require a client secret. Google test-user
# passwords belong only in Google and must never be stored in this file.
